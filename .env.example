OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://workspace:replace-with-a-long-random-password@localhost:5432/workspace_hub
SOURCE_ROOT=
SOURCES_CONFIG=sources.yaml
INDEX_POLICY_CONFIG=index-policy.yaml
CHUNK_SIZE=1400
CHUNK_OVERLAP=180
MAX_FILE_SIZE_MB=50
EXCLUDED_DIRS=bin,obj,node_modules,.git,vendor,packages,dist,build,cache,tmp,.vs,.idea
SQLITE_DATABASE_PATH=

SESSION_HOURS=12
MANAGED_UPLOAD_DIR=generated_docs/managed_uploads
BACKUP_DIR=backups
MAX_UPLOAD_SIZE_MB=25
AUTO_INDEX_ENABLED=false
AUTO_INDEX_INTERVAL_MINUTES=1440
OPENAI_MONTHLY_BUDGET_USD=5.00
# 2026-09-15時点。OpenAI公式料金ページの改定時に更新してください。
OPENAI_EMBEDDING_INPUT_USD_PER_MILLION=0.02
OPENAI_CHAT_INPUT_USD_PER_MILLION=0.15
OPENAI_CHAT_OUTPUT_USD_PER_MILLION=0.60
# Googleログイン（Google Cloudの「ウェブアプリケーション」OAuthクライアント）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
# カンマ区切り。許可ドメインとのどちらかを設定します。
GOOGLE_ALLOWED_EMAILS=
GOOGLE_ALLOWED_DOMAIN=

# Local-only image search (images are never sent to OpenAI)
IMAGE_ROOT=sample-data/images
IMAGE_SIMILARITY_THRESHOLD=0.45
# SNS実績収集（OpenAIは使用しません）
SNS_AUTO_SYNC_ENABLED=true
SNS_AUTO_SYNC_INTERVAL_MINUTES=1440
SNS_MAX_POSTS_PER_PLATFORM=200
SNS_INCREMENTAL_POSTS_PER_PLATFORM=50
SNS_OPENAI_ANALYSIS_ENABLED=false
# YouTube OAuth 2.0（読取権限）
YOUTUBE_WORKSPACE_KEY=workspace
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
# Meta Graph API（顧客単位。META_<WORKSPACE>_* で分離）
META_WORKSPACES=workspace,demo
META_WORKSPACE_APP_ID=
META_WORKSPACE_APP_SECRET=
META_WORKSPACE_PAGE_ID=
META_WORKSPACE_INSTAGRAM_ACCOUNT_ID=
META_WORKSPACE_ACCESS_TOKEN=
META_WORKSPACE_GRAPH_VERSION=v26.0
META_DEMO_APP_ID=
META_DEMO_APP_SECRET=
META_DEMO_PAGE_ID=
META_DEMO_INSTAGRAM_ACCOUNT_ID=
META_DEMO_ACCESS_TOKEN=
META_DEMO_GRAPH_VERSION=v26.0
META_REQUEST_MAX_RETRIES=2
# GA4 Data API（読取専用サービスアカウント）
GA4_WORKSPACE_KEY=workspace
GA4_PROPERTY_ID=
GA4_CREDENTIALS_PATH=secrets/ga4-service-account.json
# 顧客別のGA4プロパティ。認証ファイルを共有できる場合、CREDENTIALS_PATHは省略できます。
GA4_WORKSPACE_PROPERTY_ID=
GA4_DEMO_PROPERTY_ID=
# GA4_DEMO_CREDENTIALS_PATH=secrets/ga4-service-account.json

# Googleビジネスプロフィール（無料・読取専用）
# OAuthクライアントはGoogleログイン用と共用できます。別にする場合だけ下記2項目を設定します。
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
# Location IDとrefresh tokenは必ず顧客別に設定し、別顧客へ流用しません。
# デモワークスペースは未設定のままで動作します。
GBP_WORKSPACE_LOCATION_ID=
GBP_WORKSPACE_REFRESH_TOKEN=
GBP_DEMO_LOCATION_ID=
GBP_DEMO_REFRESH_TOKEN=
